{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "i18n:extract": "i18next 'src/**/*.{ts,tsx}'",
    "i18n:check": "i18next 'src/**/*.{ts,tsx}' --fail-on-update",
    "i18n:cleanup": "i18next 'src/**/*.{ts,tsx}' --keep-removed=false",
    "i18n:translate": "bun run scripts/translate-i18n.ts",
    "i18n:translate:estimate": "bun run scripts/translate-i18n.ts --estimate",
    "i18n:translate:dry": "bun run scripts/translate-i18n.ts --dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
